# PostgreSQL connection
DATABASE_URL=postgres://ettaka:ettaka@localhost:5432/ettaka

# API port
PORT=4000

# Change this to a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini (https://aistudio.google.com/apikey). Leave empty to run with the built-in fallbacks.
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-2.5-flash

# Public URL of the web app, used inside QR codes (use your laptop's LAN IP for phone scanning at the demo)
PUBLIC_APP_URL=http://localhost:5173

# Enables the "simulate tampering" buttons for LC officials. Set to false in production.
DEMO_MODE=true
